{
  "name": "mixmap",
  "version": "0.1.0",
  "description": "See your Ableton Live set as a 3D mix map. Runs in the browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5175",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "demo": "node scripts/make-demo.ts"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.10.1",
    "@types/three": "0.170.0",
    "eslint": "9.16.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vite": "6.0.3"
  }
}
